{
  "name": "histoiren",
  "version": "0.2.0",
  "private": true,
  "description": "Atlas historique : événements, pays et apprentissage",
  "scripts": {
    "start": "npm run build && node scripts/serve.mjs",
    "build": "node scripts/build-pages.mjs",
    "lint": "npx eslint src tests eslint.config.mjs scripts/build-pages.mjs",
    "build:countries": "node scripts/generate-countries-from-csv.mjs",
    "import:csv-timeline": "node scripts/import-csv-events.mjs",
    "test:e2e": "node tests/run-e2e.js",
    "add-events": "node scripts/add-timeline-events.mjs",
    "add-massive-events": "node scripts/add-massive-events.mjs",
    "verify-dates": "node scripts/verify-dates-wikidata.mjs",
    "sync:history": "node scripts/day-in-history-sync.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "playwright": "^1.35.0"
  }
}
